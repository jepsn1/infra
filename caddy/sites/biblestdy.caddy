biblestdy.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy biblestdy-api:3001
	}

	# Hashed assets: real 404 for missing chunks (never the SPA fallback — the
	# browser would execute index.html as JS and react-router reload-loops),
	# cache forever since filenames change per build.
	handle /assets/* {
		root * /srv/apps/biblestdy/apps/web/build/client
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: static build (pnpm --filter @biblestdy/web build), client-side routing fallback.
	# no-cache: revalidate index.html every load so deploys take effect immediately.
	handle {
		root * /srv/apps/biblestdy/apps/web/build/client
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
